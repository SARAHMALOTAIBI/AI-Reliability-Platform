from fastapi import FastAPI

from app.schemas.health_check import HealthCheckRequest
from evaluation.generation.semantic_evaluator import evaluate_semantically

app = FastAPI(
    title="AI Reliability Platform",
    version="0.1.0",
)


@app.get("/")
def root() -> dict[str, str]:
    return {
        "message": "AI Reliability Platform is running"
    }


@app.get("/health")
def health() -> dict[str, str]:
    return {
        "status": "healthy",
        "service": "ai-reliability-platform",
    }


@app.post("/api/v1/health-checks")
def create_health_check(payload: HealthCheckRequest) -> dict:
    context_texts = [context.text for context in payload.contexts]

    result = evaluate_semantically(
        answer=payload.answer,
        contexts=context_texts,
        reference_answer=payload.reference_answer,
    )

    return {
        "project_id": payload.project_id,
        "question": payload.question,
        "answer": payload.answer,
        "evaluation": {
            "correctness_score": result.correctness_score,
            "faithfulness_score": result.faithfulness_score,
            "hallucination_risk": result.hallucination_risk,
            "status": result.status,
            "explanation": result.explanation,
        },
    }